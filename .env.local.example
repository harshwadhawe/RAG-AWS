# Copy to .env.local and fill in. Gitignored, and never overwritten by
# deploy/publish.sh (which regenerates .env wholesale from Terraform outputs).
#
# Anything personal belongs here: API keys, port overrides, model experiments.

# LangSmith tracing. Get a key at https://smith.langchain.com -> Settings -> API Keys.
# deploy.sh also copies this into SSM so the deployed Lambda can trace.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true

# macOS binds 5000 to AirPlay Receiver, so the local app defaults elsewhere.
PORT=5001
